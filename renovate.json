{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "regexManagers": [
    {
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "ENV GITHUB_RELEASE_(?<depName>[A-Z0-9_]+)=(?<currentValue>.*?)\\s"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{#if depName}}{{lowercase (replace '_' '-' (replace '__' '/' depName))}}{{/if}}",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": ["ENV CLAUDE_CODE_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@anthropic-ai/claude-code"
    }
  ]
}
